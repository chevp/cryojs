{
  "name": "@cryo/cryojs",
  "version": "3.1.2",
  "description": "Node.js tooling library for Cryo Engine - .cryo file parsing, validation, compilation, and random-access container access",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "browser": "dist/browser.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "bin": {
    "cryojs": "./dist/cli/index.js"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc && npm run build:browser",
    "build:watch": "tsc -w",
    "build:browser": "node scripts/build-browser.js",
    "schema:publish": "node scripts/publish-schema.js",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist"
  },
  "keywords": [
    "cryo",
    "game-engine",
    "scene",
    "parser",
    "xml",
    "lua",
    "container",
    "tar",
    "random-access"
  ],
  "author": "chevp",
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "^8.12.0",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "fast-xml-parser": "^5.10.0",
    "glob": "^10.3.10"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/node": "^20.10.0",
    "esbuild": "^0.28.1",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chevp/cryojs.git"
  }
}
