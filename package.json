{
  "name": "@cryo/cryojs",
  "version": "3.0.0",
  "description": "Node.js tooling library for Cryo Engine - .cryo file parsing, validation, compilation, and random-access container access",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cryojs": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc -w",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist"
  },
  "keywords": [
    "cryo",
    "game-engine",
    "scene",
    "parser",
    "xml",
    "lua",
    "container",
    "tar",
    "random-access"
  ],
  "author": "chevp",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.12.0",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "fast-xml-parser": "^5.10.0",
    "glob": "^10.3.10"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/node": "^20.10.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chevp/cryojs.git"
  }
}
