<?xml version="1.0" encoding="UTF-8"?>
<cryo version="1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="../../cryo-specification/cryo-file-format/cryo-1.0.xsd">
  <meta>
    <name>Forest Scene</name>
    <description>A sample forest scene demonstrating .cryo file format</description>
    <author>chevp</author>
    <tags>
      <tag>nature</tag>
      <tag>sample</tag>
    </tags>
  </meta>

  <imports>
    <asset id="tree-model" type="gltf" src="asset://models/oak_tree.gltf" />
    <asset id="player-model" type="gltf" src="asset://models/character.gltf" />
    <asset id="forest-ambient" type="audio" src="asset://audio/forest_ambient.ogg" />
  </imports>

  <scene id="forest-scene-01" name="Forest Clearing">
    <environment>
      <skybox type="procedural" time-of-day="10:30" />
      <lighting>
        <ambient color="#2a3a2a" intensity="0.3" />
        <directional id="sun"
                     color="#fffae0"
                     intensity="1.0"
                     direction="0.3, -1, 0.2"
                     cast-shadows="true" />
      </lighting>
      <fog enabled="true" color="#90b090" density="0.01" />
      <physics gravity="0, -9.81, 0" />
    </environment>

    <entities>
      <!-- Player Character -->
      <entity id="player" name="Player">
        <transform position="0, 0, 0" rotation="0, 0, 0" scale="1, 1, 1" />
        <components>
          <mesh asset="player-model" cast-shadows="true" receive-shadows="true" />
          <collider type="capsule" radius="0.3" height="1.8" />
          <rigidbody mass="70" use-gravity="true" />
          <camera fov="60" near="0.1" far="1000" />
          <audio-source asset="forest-ambient" volume="0.5" loop="true" spatial="false" />
        </components>

        <script><![CDATA[
          local move_speed = 5.0
          local look_sensitivity = 0.1

          function on_start()
            input.lock_cursor(true)
            debug.log("Player initialized")
          end

          function on_update(dt)
            -- Movement
            local move = vec3(0, 0, 0)

            if input.is_key_down("w") then
              move = move + self.forward
            end
            if input.is_key_down("s") then
              move = move - self.forward
            end
            if input.is_key_down("a") then
              move = move - self.right
            end
            if input.is_key_down("d") then
              move = move + self.right
            end

            if move:length() > 0 then
              move = move:normalized() * move_speed * dt
              self.position = self.position + move
            end

            -- Mouse look
            local delta = input.mouse_delta * look_sensitivity
            self.rotation = self.rotation * quat.euler(-delta.y, -delta.x, 0)
          end

          function on_destroy()
            input.lock_cursor(false)
          end
        ]]></script>
      </entity>

      <!-- Trees -->
      <entity id="tree-01" name="Oak Tree 1">
        <transform position="5, 0, 8" rotation="0, 45, 0" scale="1, 1, 1" />
        <components>
          <mesh asset="tree-model" />
          <collider type="capsule" radius="0.3" height="5" />
        </components>
      </entity>

      <entity id="tree-02" name="Oak Tree 2">
        <transform position="-4, 0, 6" scale="1.2, 1.2, 1.2" />
        <components>
          <mesh asset="tree-model" />
          <collider type="capsule" radius="0.36" height="6" />
        </components>
      </entity>

      <entity id="tree-03" name="Oak Tree 3">
        <transform position="8, 0, -5" scale="0.9, 0.9, 0.9" />
        <components>
          <mesh asset="tree-model" />
          <collider type="capsule" radius="0.27" height="4.5" />
        </components>
      </entity>

      <!-- Collectible Gem -->
      <entity id="gem-01" name="Forest Gem">
        <transform position="2, 1, 3" />
        <components>
          <light type="point" color="#00ff88" intensity="1.5" range="3" />
          <collider type="sphere" radius="0.3" trigger="true" />
        </components>

        <script><![CDATA[
          local bob_speed = 2.0
          local bob_height = 0.2
          local rotate_speed = 90
          local start_y = 0

          function on_start()
            start_y = self.position.y
          end

          function on_update(dt)
            -- Bobbing animation
            self.position.y = start_y + math.sin(time.total * bob_speed) * bob_height

            -- Rotation animation
            self.rotation = self.rotation * quat.euler(0, rotate_speed * dt, 0)
          end

          function on_trigger_enter(other)
            if other.id == "player" then
              -- Notify player of collection
              other:send_message("collect_gem", { value = 10, gem_id = self.id })

              -- Destroy this gem
              self:destroy()
            end
          end
        ]]></script>
      </entity>

      <!-- Light Group -->
      <entity id="lights" name="Scene Lights">
        <transform position="0, 0, 0" />
        <children>
          <entity id="light-01" name="Fill Light">
            <transform position="-10, 5, 5" />
            <components>
              <light type="point" color="#6688ff" intensity="0.5" range="20" />
            </components>
          </entity>

          <entity id="light-02" name="Rim Light">
            <transform position="10, 8, -5" />
            <components>
              <light type="spot" color="#ffaa00" intensity="0.8" range="30" />
            </components>
          </entity>
        </children>
      </entity>
    </entities>
  </scene>
</cryo>
